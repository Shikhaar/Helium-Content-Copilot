# Helium Content Copilot — Root Environment Variables Example
# -------------------------------------------------------------
# For backend configuration, copy this file (or backend/.env.example) to backend/.env:

# AI Provider: use either OpenAI or OpenRouter
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Model (e.g. openai/gpt-4o-mini, gpt-4o-mini, anthropic/claude-3.5-sonnet)
OPENAI_MODEL=openai/gpt-4o-mini

DATABASE_URL=./helium.db
HOST=0.0.0.0
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO

# For frontend configuration (optional, defaults to http://localhost:8000/api):
# NEXT_PUBLIC_API_URL=http://localhost:8000/api
