# ─────────────────────────────────────────────
# Helium Content Copilot — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# AI Provider (required for live AI recommendations)
# Leave blank to use the built-in demo fallback mode
OPENAI_API_KEY=

# Optional: override which OpenAI model to use
OPENAI_MODEL=gpt-4o-mini

# Database path (relative to backend/)
DATABASE_URL=./helium.db

# Server settings
HOST=0.0.0.0
PORT=8000

# CORS origin for the frontend dev server
FRONTEND_ORIGIN=http://localhost:3000

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
