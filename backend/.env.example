# ---------------------------------------------
# Helium Content Copilot — Backend Environment
# ---------------------------------------------
# AI Provider: use either OpenRouter or OpenAI API key
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Model (e.g. openai/gpt-4o-mini, gpt-4o-mini, anthropic/claude-3.5-sonnet)
OPENAI_MODEL=openai/gpt-4o-mini

# Database path (relative to backend/)
DATABASE_URL=./helium.db

# Server settings
HOST=0.0.0.0
PORT=8000

# CORS origin for Next.js frontend
FRONTEND_ORIGIN=http://localhost:3000

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
